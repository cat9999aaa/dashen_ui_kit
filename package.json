{
  "name": "dashen-ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:types": "tsc --noEmit",
    "check:local-assets": "node scripts/check-local-assets.mjs",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check": "bun run check:types && bun run check:ascii && bun run check:local-assets && bun run build"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/shippori-mincho-b1": "5.2.8",
    "gsap": "3.15.0",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
